function init(self)
 self.model=render.predicate({"model"});self.gui=render.predicate({"gui"});self.text=render.predicate({"text"})
end
function update(self)
 local w,h=render.get_window_width(),render.get_window_height()
 render.set_viewport(0,0,w,h);render.set_depth_mask(true);render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(.035,.055,.11,1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1,[graphics.BUFFER_TYPE_STENCIL_BIT]=0})
 render.set_depth_mask(true);render.enable_state(graphics.STATE_DEPTH_TEST);render.set_depth_func(graphics.COMPARE_FUNC_LEQUAL);render.enable_state(graphics.STATE_CULL_FACE)
 local size=math.max(16.8,11.7/(w/h));local aspect=w/h
 local view=vmath.matrix4_look_at(vmath.vector3(18,24,0),vmath.vector3(),vmath.vector3(0,1,0))
 local proj=vmath.matrix4_orthographic(-size*aspect/2,size*aspect/2,-size/2,size/2,.1,100)
 render.set_view(view);render.set_projection(proj);render.draw(self.model)
 render.disable_state(graphics.STATE_DEPTH_TEST);render.disable_state(graphics.STATE_CULL_FACE);render.set_depth_mask(false);render.enable_state(graphics.STATE_BLEND);render.set_blend_func(graphics.BLEND_FACTOR_ONE,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
 render.set_view(vmath.matrix4());render.set_projection(vmath.matrix4_orthographic(0,w,0,h,-1,1));render.draw(self.gui);render.draw(self.text);render.disable_state(graphics.STATE_BLEND)
end
