local Combat=require 'main.combat'
local Touch=require 'main.touch'
local View=require 'main.view'
local Zoom=require 'main.zoom'
local PolishFixture=require 'main.polish_fixture'
local ReplayFixture=require 'main.replay_fixture'
local PowerFixture=require 'main.power_fixture'
local CampaignFixture=require 'main.campaign_fixture'
local DroneControls=require 'main.drone_controls'

local function voice(self,id)
 if self.muted or not self.clips[id]then return end
 local contextual=id:match('^defold_drone_')~=nil or id:match('^defold_campaign_')~=nil or id=='defold_treasure_hint' or id=='defold_zoom_help' or id:match('^defold_power_')~=nil or id:match('^defold_sanctuary_')~=nil or id=='defold_shop_tiers' or id=='defold_health_refill' or id:match('^flow_')~=nil or id:match('^bonus_')~=nil or id:match('^defold_trap_')~=nil or(id=='defold_controls'and self.voice_id and (self.voice_id:match('^defold_trap_')~=nil or self.voice_id:match('^defold_drone_')~=nil))
 if contextual then
  if self.voice_id then sound.stop('#'..self.voice_id)end
  self.voice_left=0;self.voice_next=nil;self.follow_enemy_tap=false
 elseif self.voice_left>0 then
  if self.voice_next~='defold_controls'and not self.follow_enemy_tap then self.voice_next=id end
  return
 end
 sound.play('#'..id);self.voice_id=id;self.voice_left=self.clips[id].seconds
 if id=='defold_controls'then self.follow_enemy_tap=true end
end
local function music_update(self)
 local paused=self.muted or self.g.background or self.g.saved.music==false
 sound.pause('#music',paused)
 self.g.music_active=not paused
 local volume=self.voice_left>0 and .065 or(self.g.dialog and .24 or self.g.in_sanctuary and .20 or .28)
 sound.set_gain('#music',volume);self.g.music_gain=paused and 0 or volume
end
local function clear_fragments(self)
 for _,ids in pairs(self.fragments or{})do for _,id in ipairs(ids)do go.delete(id)end end
 self.fragments={}
end
local function sprite_frame(id,x,y,columns,rows,flip,flash)
 go.set(msg.url(nil,id,'model'),'frame',vmath.vector4(x,y,columns,rows))
 go.set(msg.url(nil,id,'model'),'tint',vmath.vector4(flash and 1.65 or 1,flash and 1.35 or 1,flash and 1.2 or 1,flip and -1 or 1))
end
local function replace_hero(self)
 for _,id in ipairs(self.hero_ids or{})do go.delete(id)end
 if self.hero_power_shield then go.delete(self.hero_power_shield)end
 for _,id in ipairs(self.hero_sparks or{})do go.delete(id)end;self.hero_sparks={}
 for i=1,6 do self.hero_sparks[i]=factory.create('#hero_aura',vmath.vector3(0,0,0))end
 self.hero_power_shield=factory.create('#hero_power_shield',vmath.vector3(0,-100,0));go.set_scale(.001,self.hero_power_shield)
 self.hero=factory.create('#illustrated_'..self.g:character().id,vmath.vector3(0,0,0))
 self.hero_ids={self.hero};self.hero_parts={};self.wings={};self.hero_frame=0;self.hero_row=0;self.hero_flip=false
end
local function animate_hero(self,dt)
 local g=self.g;local walking=#g.path>0 and not g.paused and not g.tactical_pause
 local stage=g.dialog~=nil;local time=self.visual_clock;local recoil=(g.recoil or 0)/.20
 local power=g.power_state and g:power_state()or{count=0,total=12,visual_scale=1,cloak_multiplier=1}
 local strength=math.max(0,math.min(1,power.count/math.max(1,power.total)))
 local target_scale=math.max(1,math.min(1.75,power.visual_scale or 1))
 self.hero_visual_scale=(self.hero_visual_scale or target_scale)+(target_scale-(self.hero_visual_scale or target_scale))*math.min(1,dt*4)
 g.hero_visual_scale=self.hero_visual_scale
 local size=self.hero_visual_scale
 local opacity=stage and 1 or(.3+.7*math.max(.1,math.min(1,power.cloak_multiplier or 1)))
 local power_flash=math.max(0,math.min(1,(g.power_flash or 0)/2))
 local yaw=(g.aiming or g.held or g.cooldown>.1)and math.atan2(g.aim[1],g.aim[2])or(g.facing or 0)
 local frame=walking and math.floor(time*9)%4 or 0
 local row=not stage and math.cos(yaw)<-.15 and 1 or 0
 local flip=not stage and math.sin(yaw)<-.1
 local motion=walking and 1 or 0;self.hero_motion=(self.hero_motion or 0)+(motion-(self.hero_motion or 0))*math.min(1,dt*10)
 local phase=time*9*math.pi/2;local breathe=math.sin(time*2.5)
 local bob=math.abs(math.sin(phase))*.045*self.hero_motion+math.sin(time*2.8)*.012
 local sway=math.sin(phase)*.035*self.hero_motion+math.sin(time*1.7)*.012
 go.set_position(vmath.vector3(g.p[1],bob,g.p[2]),self.hero)
 go.set_rotation(vmath.quat_rotation_z(sway-recoil*.075),self.hero)
 go.set_scale(vmath.vector3((1+breathe*.012+recoil*.045)*size,(1-breathe*.010-recoil*.065)*size,size),self.hero)
 sprite_frame(self.hero,frame,row,4,2,flip,g.invulnerable>0 and math.floor(time*12)%2==0)
 local id=g:character().id;local seed=id=='dragon'and 2 or id=='fox'and 3 or 1
 go.set(msg.url(nil,self.hero,'model'),'hero_fx',vmath.vector4(self.capture_hero_fx_off and 0 or time,self.hero_motion,recoil,self.capture_hero_fx_off and 0 or seed))
 go.set(msg.url(nil,self.hero,'model'),'power_fx',vmath.vector4(opacity,strength,power_flash,0))
 for i,node in ipairs(self.hero_sparks)do
  local a=time*(.7+i*.055+strength*.25)+i*2.399963;local r=(.48+.13*math.sin(time+i))*size;local y=(.35+(i%3)*.32+.12*math.sin(time*1.5+i))*size
  go.set_position(vmath.vector3(g.p[1]+math.cos(a)*r,y,g.p[2]+math.sin(a)*r*.65),node);go.set_rotation(vmath.quat_rotation_x(-math.atan2(24,18)),node)
  go.set_scale(self.capture_hero_fx_off and .001 or(.075+.025*math.sin(time*2+i))*(1+strength*.85+power_flash*.4),node)
  local color=seed==2 and vmath.vector4(1,.56,.12,.65)or seed==3 and vmath.vector4(.64,.4,1,.65)or vmath.vector4(.15,.86,1,.65)
  if strength>0 then color=vmath.lerp(strength*.6,color,vmath.vector4(1,.77,.22,.8))end
  go.set(msg.url(nil,node,'model'),'tint',color)
 end
 if self.hero_power_shield then
  local active=power.count>0 and(g.shield or 0)>0
  local ratio=math.max(0,math.min(1,(g.shield or 0)/math.max(1,g.max_shield or 1)))
  go.set_position(vmath.vector3(g.p[1],active and .025 or-100,g.p[2]),self.hero_power_shield)
  go.set_scale(active and size*(.78+(stage and 0 or power_flash*.07))or .001,self.hero_power_shield)
  go.set(msg.url(nil,self.hero_power_shield,'model'),'frame',vmath.vector4(time,0,1,1))
  go.set(msg.url(nil,self.hero_power_shield,'model'),'tint',vmath.vector4(.25+strength*.65,.85,1-strength*.55,(.32+strength*.38)*ratio))
 end
 self.hero_frame=frame;self.hero_row=row;self.hero_flip=flip
 if g.motion_capture and walking and frame>0 and not self.capture_walk_proof then self.capture_walk_proof=true;print('DEFOLD CAPTURE WALK FRAME PASS')end
 if g.motion_capture and g.held and g.touch.pointer and g.touch.pointer.mode=='fire'and g.shots_fired>=2 and not self.capture_hold_proof then self.capture_hold_proof=true;print('DEFOLD CAPTURE HELD FIRE PASS')end
 if g.motion_capture and g.shots_fired>=2 and not self.capture_fire_proof then self.capture_fire_proof=true;print('DEFOLD CAPTURE FIRED PASS')end
 if walking then
  self.walk_frames=self.walk_frames or{};self.walk_frames[frame]=true
  if self.ui_test and not self.motion_checked then local n=0;for _ in pairs(self.walk_frames)do n=n+1 end
   if n>=2 then self.motion_checked=true;print('DEFOLD ACTUAL ILLUSTRATED WALK PASS')end
  end
 end
end
local function clear_projectiles(self)
 for _,id in pairs(self.projectile_nodes or{})do go.delete(id)end
 for _,id in pairs(self.halo_nodes or{})do go.delete(id)end
 for _,trail in ipairs(self.trails or{})do go.delete(trail.id)end
 self.projectile_nodes={};self.halo_nodes={};self.trails={}
end
local function glow_color(b,alpha)
 if b.visual=='fireball'then return vmath.vector4(1,.34,.045,alpha)end
 if not b.enemy and(b.damage or 1)>=4 then return vmath.vector4(1,.24,.65,alpha)end
 if not b.enemy and(b.damage or 1)>=3 then return vmath.vector4(1,.65,.12,alpha)end
 if not b.enemy and(b.damage or 1)>=2 then return vmath.vector4(.55,.35,1,alpha)end
 if b.visual=='treasure'then return vmath.vector4(1,.72,.13,alpha)end
 return b.enemy and vmath.vector4(1,.10,.22,alpha)or vmath.vector4(.09,.76,1,alpha)
end
local function glow(self,p,b,alpha)
 local id=factory.create('#glow',vmath.vector3(p[1],.65,p[2]));go.set_rotation(vmath.quat_rotation_x(-math.atan2(24,18)),id)
 go.set(msg.url(nil,id,'model'),'tint',glow_color(b,alpha));return id
end
local function draw_projectiles(self,dt)
 local alive={}
 for i=#self.trails,1,-1 do local t=self.trails[i];t.life=t.life-dt
  if t.life<=0 then go.delete(t.id);table.remove(self.trails,i)else go.set_scale(t.life/.19*.65,t.id)end
 end
 for _,b in ipairs(self.g.bullets)do
  alive[b]=true
  if not self.projectile_nodes[b]then
   self.projectile_nodes[b]=factory.create(b.visual=='fireball'and'#fireball'or b.enemy and'#enemy_bolt'or'#bolt',vmath.vector3(0,0,0));self.halo_nodes[b]=glow(self,b.p,b,.6)
  end
  local id=self.projectile_nodes[b]
  go.set_position(vmath.vector3(b.p[1],.65,b.p[2]),id);go.set_position(vmath.vector3(b.p[1],.65,b.p[2]),self.halo_nodes[b])
  go.set_rotation(vmath.quat_rotation_y(math.atan2(b.direction[1],b.direction[2])),id)
  local amplification=math.min(2.2,1+math.max(0,(b.damage or 1)-1)*.10)
  go.set_scale(math.max(.01,b.alpha)*(b.visual=='fireball'and 1.35 or 1)*amplification,id);go.set_scale(math.max(.01,b.alpha)*.70,self.halo_nodes[b])
  b.trail_clock=(b.trail_clock or 0)+dt
  if not self.g.paused and b.trail_clock>.045 then
   b.trail_clock=0
   if #self.trails>=((self.g.data.campaign_enabled or self.g.data.campaign_v14)and 48 or 80)then go.delete(self.trails[1].id);table.remove(self.trails,1)end
   self.trails[#self.trails+1]={id=glow(self,b.p,b,.34),life=.19}
  end
 end
 for b,id in pairs(self.projectile_nodes)do if not alive[b]then go.delete(id);if self.halo_nodes[b]then go.delete(self.halo_nodes[b])end;self.halo_nodes[b]=nil;self.projectile_nodes[b]=nil end end
end
local native_kinds={mini_drone=true,splitter=true,crawler=true,wisp=true}
local function delete_enemy(self,enemy)
 for _,key in ipairs({'node','shadow','field'})do
  local id=enemy[key];if id and go.exists(id)then go.delete(id)end;enemy[key]=nil
 end
 if self.enemy_nodes then self.enemy_nodes[enemy]=nil end
end
local function ensure_enemy(self,enemy)
 if enemy.node and go.exists(enemy.node)then return end
 self.enemy_nodes=self.enemy_nodes or{};self.enemy_nodes[enemy]=true
 enemy.native_unit=native_kinds[enemy.kind]==true
 enemy.illustrated=not enemy.native_unit and not enemy.optional and enemy.kind~='relay'and enemy.kind~='sequence'
 enemy.shadow=factory.create('#shadow',vmath.vector3(enemy.p[1],0,enemy.p[2]))
 local model=enemy.native_unit and('enemy_'..enemy.kind)or enemy.illustrated and('illustrated_'..(enemy.boss and'boss'or enemy.trap_shield and'guardian'or'sentinel'))or'illustrated_relay'
 enemy.node=factory.create('#'..model,vmath.vector3(enemy.p[1],0,enemy.p[2]))
 if enemy.shield or enemy.boss then enemy.field=factory.create('#energy_field',vmath.vector3(enemy.p[1],0,enemy.p[2]))end
 enemy.model_pending=nil
end
local function rebuild(self,index)
 clear_fragments(self);clear_projectiles(self)
 for enemy in pairs(self.enemy_nodes or{})do delete_enemy(self,enemy)end;self.enemy_nodes={}
 for _,id in ipairs(self.objects or{})do go.delete(id)end;self.objects={};self.g:load(index)
 local zoom=View.zoom_factor(self.g.zoom or 1,self.g)
 if self.g.zoom~=zoom then self.g.zoom=zoom;self.g.saved.zoom=zoom;self.g.changed()end
 local function make(name,p)
  local id=factory.create('#'..name,vmath.vector3(p[1],0,p[2]));self.objects[#self.objects+1]=id;return id
 end
 local arena_model=self.g.m.arena_model or self.g.m.id
 self.arena=make(arena_model,{0,0});self.ground=make(arena_model..'_ground',{0,0});replace_hero(self)
 self.cover_shadows={}
 for _,wall in ipairs(self.g.walls)do if wall.type~='border'then local r=wall.r;local id=make('cover_shadow',{r[1]+r[3]/2+.1,r[2]+r[4]/2+.1});go.set_position(vmath.vector3(r[1]+r[3]/2+.1,.077,r[2]+r[4]/2+.1),id);go.set_scale(vmath.vector3(r[3]+.65,1,r[4]+.65),id);go.set(msg.url(nil,id,'model'),'frame',vmath.vector4(r[3]/(r[3]+.65),r[4]/(r[4]+.65),.42,0));self.cover_shadows[#self.cover_shadows+1]=id end end
 self.selection=make('selection_ring',self.g.p);self.hero_shadow=make('shadow',self.g.p);self.chest=nil;self.chest_glow=nil
 if self.g.m.secret and not self.g.data.campaign_enabled then
  self.chest=make('illustrated_chest',self.g.m.secret.position);self.chest_glow=glow(self,self.g.m.secret.position,{visual='treasure'},.48);self.objects[#self.objects+1]=self.chest_glow
 end
 self.gate=self.g.m.gate_rect and make('gate',{0,0})or nil
 self.drone=self.g.drone and make('illustrated_drone',self.g.drone.p)or nil
 self.lobby=not self.g.data.campaign_enabled and make('lobby',self.g.p)or nil
 self.sanctuary=nil;self.sanctuary_field=nil
 if self.g.m.sanctuary then
  local zone=self.g.m.sanctuary
  self.sanctuary=make('sanctuary',zone.position);self.sanctuary_field=make('energy_field',zone.position)
 end
 self.heal=self.g.m.heal and make('illustrated_heal',self.g.m.heal)or nil
 for _,id in pairs(self.device_nodes or{})do go.delete(id)end;self.device_nodes={}
 for _,t in ipairs(self.g.enemies)do ensure_enemy(self,t)end
 View.follow(self.g,0,true)
 if not self.suppress_intro then self.g.say(self.g.m.voice or(self.g.m.id=='dock'and'raid_dock'or'combat_'..self.g.m.id));if self.g.m.kind~='trap'then self.voice_next='defold_controls'end end
end
local function render_fragments(self)
 local campaign=self.g.data.campaign_enabled or self.g.data.campaign_v14
 local alive={};local count=0
 local effects={}
 if campaign then for _,f in ipairs(self.g.fx)do if f.kind=='lightning'and f.primary then effects[#effects+1]=f end end end
 for index=#self.g.fx,1,-1 do local f=self.g.fx[index];if not(campaign and f.kind=='lightning'and f.primary)then effects[#effects+1]=f end end
 for _,f in ipairs(effects)do
  if(f.kind=='explosion'or(campaign and f.kind=='lightning'))and(not campaign or count<8)then
   count=count+1;alive[f]=true
   if f.kind=='lightning'then
    if not self.fragments[f]then self.fragments[f]={factory.create('#unit_lightning',vmath.vector3(f.p[1],.12,f.p[2]))}end
    local id=self.fragments[f][1];local pulse=.8+math.abs(math.sin((f.age or 0)*42))*.55
    go.set_scale(vmath.vector3(pulse,1.05+math.sin((f.age or 0)*28)*.18,pulse),id)
    go.set_rotation(vmath.quat_rotation_y((f.age or 0)*9),id)
   else
    local bits=campaign and 4 or 10;local atlas=bits+1
    if not self.fragments[f]then
     self.fragments[f]={}
     for j=1,bits do self.fragments[f][j]=factory.create(j%2==0 and'#spark_hot'or'#spark',vmath.vector3(f.p[1],.8,f.p[2]))end
     self.fragments[f][atlas]=factory.create('#illustrated_explosion',vmath.vector3(f.p[1],.1,f.p[2]))
    end
    for j,id in ipairs(self.fragments[f])do
     if j==atlas then local frame=math.min(7,math.floor(f.age/.9*8));sprite_frame(id,frame%4,math.floor(frame/4),4,2,false,false)
     else local a=j*2.399963;local speed=1.6+(j%3)*.65;local t=f.age
      go.set_position(vmath.vector3(f.p[1]+math.cos(a)*speed*t,.8+(2.8+(j%2))*t-4*t*t,f.p[2]+math.sin(a)*speed*t),id)
      go.set_rotation(vmath.quat_rotation_z(t*(j%2==0 and 9 or-9))*vmath.quat_rotation_y(a+t*5),id)
      go.set_scale(math.max(.001,f.life/.9)*(1+(j%3)*.3),id)
     end
    end
   end
  end
 end
 for f,ids in pairs(self.fragments)do if not alive[f]then for _,id in ipairs(ids)do go.delete(id)end;self.fragments[f]=nil end end
end
local function draw_campaign_units(self,dt)
 if not(self.g.data.campaign_enabled or self.g.data.campaign_v14)then return end
 local heights={mini_drone=1.45,splitter=1.35,crawler=1.1,wisp=1.8}
 for index,e in ipairs(self.g.enemies)do if heights[e.kind]and e.node and go.exists(e.node)then
  e.ui_height=heights[e.kind];e.native_unit=true
  local seed=e.uid or index;local phase=self.visual_clock*(e.kind=='wisp'and 2.2 or 4.5)+seed
  local hover=e.kind=='mini_drone'and(.42+math.sin(phase)*.11)or e.kind=='wisp'and(.65+math.sin(phase)*.2)or e.kind=='splitter'and(.11+math.sin(phase)*.035)or .025
  local d=e.direction or{0,1};local yaw=math.atan2(d[1],d[2])+math.pi
  if e.kind=='wisp'then yaw=phase*.7 end
  local bank=e.kind=='crawler'and math.sin(phase*2)*.035 or math.sin(phase)*.08
  go.set_position(vmath.vector3(e.p[1],hover,e.p[2]),e.node)
  go.set_rotation(vmath.quat_rotation_y(yaw)*vmath.quat_rotation_z(bank),e.node)
  local age=e.death_age;local size=e.hp>0 and 1 or(age and math.max(.001,1-age/.32)or .001)
  local pulse=e.kind=='splitter'and(1+math.sin(phase*.6)*.04)or 1
  go.set_scale(vmath.vector3(size*pulse,size*(1-bank*.4),size*pulse),e.node)
 end end
end
local function draw_attack_drone(self,dt)
 local state=self.g.attack_drone
 if self.attack_drone_owner~=state then
  if self.attack_drone_node and go.exists(self.attack_drone_node)then go.delete(self.attack_drone_node)end
  if self.attack_drone_glow and go.exists(self.attack_drone_glow)then go.delete(self.attack_drone_glow)end
  self.attack_drone_node=nil;self.attack_drone_glow=nil;self.attack_drone_owner=state;self.attack_drone_last=nil
 end
 if not state or state.phase~='flying'or not state.p then
  if self.attack_drone_node and go.exists(self.attack_drone_node)then go.delete(self.attack_drone_node)end
  if self.attack_drone_glow and go.exists(self.attack_drone_glow)then go.delete(self.attack_drone_glow)end
  self.attack_drone_node=nil;self.attack_drone_glow=nil;self.attack_drone_last=nil;return
 end
 if not self.attack_drone_node then
  self.attack_drone_node=factory.create('#attack_drone',vmath.vector3(state.p[1],.8,state.p[2]))
  self.attack_drone_glow=glow(self,state.p,{visual='fireball'},.35)
 end
 local p=state.p;local prior=self.attack_drone_last or p;local dx,dz=p[1]-prior[1],p[2]-prior[2]
 if dx*dx+dz*dz>.000001 then self.attack_drone_yaw=math.atan2(dx,dz)+math.pi end
 local hover=.82+math.sin(self.visual_clock*12)*.035
 go.set_position(vmath.vector3(p[1],hover,p[2]),self.attack_drone_node)
 go.set_rotation(vmath.quat_rotation_y(self.attack_drone_yaw or 0)*vmath.quat_rotation_z(math.sin(self.visual_clock*16)*.035),self.attack_drone_node)
 go.set_position(vmath.vector3(p[1],hover+.10,p[2]),self.attack_drone_glow);go.set_scale(.35+.05*math.sin(self.visual_clock*10),self.attack_drone_glow)
 self.attack_drone_last={p[1],p[2]}
end
local function bind_controls(g)
 g.project=View.project
 g.touch=Touch.new(g,function(x,y)return View.ground(g,x,y)end)
 g.zoom_control=Zoom.new(g)
 g.drone_control=DroneControls.new(g)
 g.input=function(a)g.touch:input(a)end
 g.control_tick=function(dt)g.touch:update(dt);g.drone_control:update(dt)end
end
local function run_tests(self)
 -- Retain the previous combat regression against its original arena fixture.
 local prior=Combat.new(json.decode(sys.load_resource('/data/raid-03.json')))
 prior.camera={0,0};bind_controls(prior);prior.cancel_controls=function()prior.touch:cancel()end
 local n=require('main.regression_checks').run(prior)
 -- Historical0.7data preserves the original assertions while new rewards grow.
 local legacy=Combat.new(json.decode(sys.load_resource('/data/defold07.json')))
 legacy.camera={0,0};bind_controls(legacy);legacy.cancel_controls=function()legacy.touch:cancel()end
 legacy.data.shop_enabled=false
 n=n+require('main.defold04_checks').run(legacy)
 n=n+require('main.reflection_checks').run(legacy)
 legacy.data.shop_enabled=true
 n=n+require('main.toybox_checks').run(legacy)
 n=n+require('main.trap_checks').run(legacy)
 n=n+require('main.flow_checks').run(self.g)
 n=n+require('main.bonus_checks').run(self.g.data)
 n=n+require('main.direct_touch_checks').run(self.g.data)
 -- Preserve the historical shop's exact 15..35 HP / 1..4 damage checks while
 -- new power checks and real GUI tests exercise the active combined rules.
 n=n+require('main.resilience_checks').run(json.decode(sys.load_resource('/data/defold12.json')))
 n=n+require('main.zoom_checks').run(self.g.data)
 n=n+require('main.treasure_checks').run(self.g.data)
 n=n+require('main.replay_checks').run(self.g.data)
