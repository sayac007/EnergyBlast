 self.g=Combat.new(data,saved);self.g.muted=self.muted;bind_controls(self.g)
 local capture_zoom=sys.get_config_number('project.capture_zoom',1);if capture_zoom~=1 then self.g.zoom_control:set(capture_zoom)end
