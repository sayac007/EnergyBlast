  local bonus_node=box(self,720,648,168,42,'ffffff');gui.set_color(bonus_node,vmath.vector4(1,1,1,0));icon(self,655,649,'star',24);text(self,720,650,'BONI '..state.bonus_done..'/'..state.bonus_total,'c0e6dc',.45,140);self.buttons[#self.buttons+1]={node=bonus_node,action='track_bonus',rect={720,648,168,42}}
  local chest_node=picture(self,904,648,190,42,'button_'..(state.treasures_remaining>0 and'gold'or'green'),nil,true)
  picture(self,835,650,31,31,'chest-prop');text(self,919,650,state.treasure_replay and'NOCHMAL 0/1'or state.treasures_remaining>0 and'SCHATZ 0/1'or'SCHATZ 1/1','ffffff',.38,143)
  self.buttons[#self.buttons+1]={node=chest_node,action='track_treasure',rect={904,648,190,42}}
 end
 if g.flow_ui_test and self.flow_play_mission~=g.index then self.flow_play_mission=g.index;print('DEFOLD FLOW PLAY READY mission='..g.index..' treasure='..state.treasures_remaining..' bonus='..state.bonus_total)end

 local hero_thumb=portrait(self,72,548,g:character().id,135);self.buttons[#self.buttons+1]={node=hero_thumb,action='characters',rect={72,548,135,135}}
 icon(self,26,466,'heart',25);text(self,85,467,'ENERGIE','c7e3ef',.41,92)
 local hp_node=text(self,72,449,PowerFormat.number(g.hp),'ffffff',.68,126)
 text(self,72,434,'VON '..PowerFormat.number(g.max_hp),'b8e0e8',.38,126)
 local ratio=clamp(g.hp/math.max(1,g.max_hp),0,1);box(self,72,421,112,16,'0a1830')
 if ratio>0 then box(self,17+55*ratio,421,110*ratio,12,g.regenerating and '80f9bd'or ratio<.3 and 'ffb878'or '56d8cf')end
 text(self,72,405,g.in_sanctuary and 'GESCHUETZT'or g.regenerating and 'ERHOLUNG'or g.hp>=g.max_hp and 'VOLLE ENERGIE'or 'ERHOLUNG BALD','99dfcd',.32,125)
 local power=power_state(g)
 power_button(self,g,1208,593,120,52)
 if (g.max_shield or 0)>0 then
