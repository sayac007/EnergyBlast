local function selected_button(self,g,a)
 if not a.pressed then return nil end
 -- HUD always wins over field modes; its explicit logical rectangles also work
 -- for transparent labels and card nodes parented to clipping containers.
 if campaign(g)then
  for _,b in ipairs(self.buttons)do if not b.world and picked(g,b,a.x,a.y)then return b end end
 end
 for _,b in ipairs(self.buttons)do if picked(g,b,a.x,a.y)then return b end end
end
local function handle(self,a)
 local g=_G.energyblast;if not g then return false end
 local key=a.id or 0;local captured=self.ui_pointers[key]
 if captured then if a.released then if captured=='fire'then g.held=false end;self.ui_pointers[key]=nil end;return true end
 local chosen=selected_button(self,g,a)
 local hud=campaign(g)and chosen and not chosen.world
 if g.trap_ui and not hud then
  if a.pressed then for _,b in ipairs(self.buttons)do if b.world and picked(g,b,a.x,a.y)then
   self.ui_pointers[key]=b.action
   if b.action=='trap_cancel'then g.trap_control:cancel(true)
   elseif b.action:sub(1,12)=='trap_select:'then g.trap_control:select(b.action:sub(13))end
   return true
  end end end
  if field(g,a.x,a.y)then g.trap_control:input(a)elseif a.released then g.trap_control.pointer=nil end
  return true
 end
 if campaign(g)and g.drone_control and(g.drone_ui or g.drone_control:blocks_input())and not hud then
  local drone_button=chosen and(chosen.action=='drone_select'or chosen.action=='drone_cancel'or chosen.action=='drone_open')
  if not drone_button then g.drone_control:input(a);return true end
 end
 if not a.pressed then g.input(a);return true end
 if chosen then
  local action=chosen.action
  if g.ui_test then print('DEFOLD UI ACTION '..action..' paused='..tostring(g.paused))end
  if g.flow_ui_test then print('DEFOLD FLOW ACTION '..action)end
  if g.campaign_ui_test then print('DEFOLD CAMPAIGN ACTION '..action..' mission='..g.index..' paused='..tostring(g.paused))end
  -- FEUER/DASH/zoom cannot leave a held-shot tail behind a tactical selection.
  if campaign(g)and(g.trap_ui or g.drone_ui)and(action=='fire'or action=='dash'or action=='zoom_in'or action=='zoom_out')then self.ui_pointers[key]=action;return true end
  if campaign(g)and(action=='zoom_in'or action=='zoom_out')and g.drone_control and not g.drone_ui then g.drone_control:keep_view()end
  local drone_action=action=='drone_open'or action=='drone_select'or action=='drone_cancel'
  local tactical_help=campaign(g)and(g.trap_ui or g.drone_ui)and(action=='radio'or action=='hint')
  if not drone_action and not tactical_help and action~='fire'and action~='dash'and action~='hint'and action~='trap'then
   if campaign(g)and g.trap_ui then g.trap_control:cancel(false)end
   g.cancel_controls()
  end
  self.ui_pointers[key]=action
  if action=='zoom_in'or action=='zoom_out'then g.zoom_control:step(action=='zoom_in'and 1 or-1);if not g.saved.zoom_help_heard then g.saved.zoom_help_heard=true;g.changed();g.say('defold_zoom_help')end
  elseif action=='treasure_walk'then local t=g:treasure_state();g:navigate(t.discovered and t.position or t.hint);g.status=t.discovered and'ZUR TRUHE - FOLGE DEM GOLDENEN ZEICHEN'or'ZUM GOLDENEN SUCHGEBIET'
  elseif action=='fire'then g.held=true;g:fire()elseif action=='dash'then g:dash()elseif action=='hint'then if g.drone_ui then g.say(g.drone_ui.mode=='target'and'defold_drone_target'or'defold_drone_open')elseif campaign(g)and g.trap_ui then g.say(g.trap_ui.mode=='place'and'defold_trap_select'or'defold_trap_open')else g:hint()end elseif action=='trap_open'then self.trap_logged_mode=nil;g.trap_control:open()
  elseif action=='drone_open'then if g.trap_ui then g.trap_control:cancel(false)end;self.logged_drone_mode=nil;g.drone_control:open()
  elseif action=='drone_select'then g.drone_control:select()
  elseif action=='drone_cancel'then g.drone_control:cancel(false);self.logged_drone_mode=nil
  elseif action:sub(1,6)=='sector'then local index=tonumber(action:sub(7));if campaign(g)then self.menu_page=math.floor((index-1)/6)+1 end;g.choose(index)
  elseif action=='missions_prev'or action=='missions_next'then self.menu_page=clamp((self.menu_page or 1)+(action=='missions_next'and 1 or-1),1,math.ceil(#g.data.missions/6));self.dialog_key=nil
  elseif action=='objective'then self.objective_return=g.dialog or false;g.paused=true;g.dialog='objective';g:guide()
  elseif action=='objective_voice'then g:guide();self.dialog_key=nil
  elseif action=='objective_close'then if self.objective_return then g.dialog=self.objective_return;g.paused=true else g:resume_mission()end;self.objective_return=nil
  elseif action=='mission_menu'then self.menu_page=math.floor((g.index-1)/6)+1;g.paused=true;g.dialog='menu';g.say('flow_menu')
  elseif action:sub(1,10)=='character:'then g.pick_character(action:sub(11));if action:sub(11)=='dragon'then g.say('flow_dragon')end
  elseif action:sub(1,9)=='shop_tab:'then self.shop_category=action:sub(10);g.shop_status=nil
  elseif action=='sanctuary'then if g.m.sanctuary then g:navigate(g.m.sanctuary.position);g.status=campaign(g)and'ZUM ZIKKURAT - GESCHUETZTER STARTPUNKT'or'ZUM ZIKURRAT - HIER BIST DU GESCHUETZT';g.say('defold_sanctuary_intro')end
  elseif action:sub(1,4)=='buy:'then
   local owned=g:owns(action:sub(5));local bought=g:buy(action:sub(5))
   if not owned then
    if bought then g.say(action:sub(5)=='health'and 'defold_health_refill'or 'flow_purchase')else
     local item=g.shop_item and g:shop_item(action:sub(5))
     if not item or g:wallet()<item.price then g.say('flow_need_stars')end
    end
   end
   if g.ui_test then if bought or g:owns(action:sub(5))then print('DEFOLD SHOP PURCHASE PASS '..action)else print('DEFOLD SHOP BLOCKED '..action)end end
   if g.flow_ui_test then print('DEFOLD FLOW PURCHASE '..action:sub(5)..' owned='..tostring(g:owns(action:sub(5)))..' wallet='..g:wallet()..' hp='..g.hp..' max='..g.max_hp)end
  elseif action=='power'then self.power_return=g.dialog or false;g.paused=true;g.dialog='power';g.say(campaign(g)and'defold_shop_tiers'or'defold_power_help')
  elseif action=='power_close'then if self.power_return then g.dialog=self.power_return;g.paused=true else g:resume_mission()end;self.power_return=nil
  elseif action=='menu'or action=='gear'or action=='characters'then if campaign(g)and action=='menu'and not g.dialog then self.menu_page=math.floor((g.index-1)/6)+1 end;g.paused=true;g.dialog=action;if action~='characters'then g.say(action=='gear'and'defold_shop_tiers'or'flow_menu')end
  elseif action=='continue'then g:resume_mission();if g.intro_needed then g.intro_needed=false;g.replay()end
  elseif action=='retry'then g.choose(g.index)
  elseif action=='loot'then g:search_loot()
  elseif action=='bonus_search'then g:resume_mission();g:track_bonus()
  elseif action=='next'then g:next_mission()
  elseif action=='track_treasure'then if not g:track_treasure()then g.say('flow_no_treasure')end;if g.flow_ui_test then print('DEFOLD FLOW TREASURE TRACK PASS remaining='..g:mission_state().treasures_remaining)end
  elseif action=='track_bonus'then g:track_bonus();if g.flow_ui_test then print('DEFOLD FLOW BONUS TRACK PASS total='..g:mission_state().bonus_total)end
  elseif action=='track_objective'then g:track_objective();g:guide()
  elseif action=='music'then g.toggle_music()elseif action=='sound'then g.toggle_sound()elseif action=='radio'then if g.drone_ui then g.say(g.drone_ui.mode=='target'and'defold_drone_target'or'defold_drone_open')elseif campaign(g)and g.trap_ui then g.say(g.trap_ui.mode=='place'and'defold_trap_select'or'defold_trap_open')else g.replay()end end
  return true
 end
 if not g.dialog and field(g,a.x,a.y)then g.input(a)end;return true
end
function on_input(self,id,a)
 local g=_G.energyblast;if not g or not g.zoom_control then return false end
 if id==hash('multitouch')then if _G.energyblast.zoom_control:input(a.touch or{})then return true end;for _,t in ipairs(a.touch or{})do handle(self,t)end;return true elseif id==hash('touch')then if _G.energyblast.zoom_control:blocks_mouse()then return true end;return handle(self,a)elseif id==hash('back')and a.pressed then _G.energyblast.cancel_controls();_G.energyblast.paused=true;_G.energyblast.dialog='menu';return true end
end
function on_message(self,id)if id==hash('cancel_controls')then self.ui_pointers={}end end
