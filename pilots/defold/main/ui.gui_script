 else
  panel(self,930,387,628,420);text(self,930,493,'NEUER ANLAUF?','ffa6c3',1.14);text(self,930,420,'Deine Sterne bleiben erhalten.','d0e5e9',.79,565)
  button(self,930,303,580,89,'NOCH EINMAL','retry','gold','dash');button(self,930,99,615,80,'MISSIONEN','menu','blue','menu')
  button(self,284,63,490,78,'STERNE AUSGEBEN · '..g:wallet(),'gear','gold','star');hero_choices(self,g)
 end
