local function color(hex)return vmath.vector4(tonumber(hex:sub(1,2),16)/255,tonumber(hex:sub(3,4),16)/255,tonumber(hex:sub(5,6),16)/255,1)end
local function box(self,x,y,w,h,c)
 local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(n,color(c));if self.world_parent then gui.set_parent(n,self.world_parent,true)end;self.nodes[#self.nodes+1]=n;return n
end
local function text(self,x,y,s,c,scale)
 local n=gui.new_text_node(vmath.vector3(x,y,0),s);gui.set_font(n,'ui');gui.set_color(n,color(c or'ecfff7'));gui.set_scale(n,vmath.vector3(scale or 1));if self.world_parent then gui.set_parent(n,self.world_parent,true)end;self.nodes[#self.nodes+1]=n;return n
end
local function circle(self,x,y,r,c)
 local n=gui.new_pie_node(vmath.vector3(x,y,0),vmath.vector3(r*2,r*2,0));gui.set_color(n,color(c));gui.set_perimeter_vertices(n,40);if self.world_parent then gui.set_parent(n,self.world_parent,true)end;self.nodes[#self.nodes+1]=n;return n
end
local function button(self,x,y,w,h,title,action,c)
 c=c or'24526a';local n=box(self,x,y,w-h,h,c);circle(self,x-(w-h)/2,y,h/2,c);circle(self,x+(w-h)/2,y,h/2,c);
 -- A full rectangular hitbox keeps the pill's ends tappable.
 local hit=box(self,x,y,w,h,c);gui.set_alpha(hit,0);text(self,x,y,title,'ecfff7',.85);self.buttons[#self.buttons+1]={node=hit,action=action};return n
end
local function line(self,x1,y1,x2,y2,c,width)
 local dx,dy=x2-x1,y2-y1;local n=box(self,(x1+x2)/2,(y1+y2)/2,math.sqrt(dx*dx+dy*dy),width or 3,c);gui.set_rotation(n,vmath.vector3(0,0,math.atan2(dy,dx)*180/math.pi))
end
function init(self)self.nodes={};self.buttons={};self.last_dialog=nil;self.ui_pointers={};msg.post('.','acquire_input_focus')end
function update(self,dt)
 local g=_G.energyblast;if not g then return end
 for _,n in ipairs(self.nodes)do gui.delete_node(n)end;self.nodes={};self.buttons={};self.world_parent=nil
 box(self,360,1207,700,120,'14233b');text(self,112,1230,tostring(g:total()),'ffd674',1.2);for i=0,4 do local a=math.pi/2+i*math.pi*2/5;local n=circle(self,45+math.cos(a)*8,1230+math.sin(a)*8,11,'ffd674');gui.set_perimeter_vertices(n,3);gui.set_rotation(n,vmath.vector3(0,0,a*180/math.pi))end
 for i=1,g.max_hp do circle(self,42+i*35,1185,10,i<=g.hp and'ff7394'or'334460')end
 text(self,350,1230,g.m.title,'afc8dd',.65);text(self,600,1185,'? '..g:credits(),'ffd674',.8)
 button(self,650,1230,68,60,'|||','menu','20314b');button(self,550,1230,68,60,g.muted and'STUMM'or'TON','sound','20314b')
 box(self,360,218,695,65,'14233b');text(self,360,238,g.status,'b8dbe7',.59)
 local alive,relays=0,0;for _,t in ipairs(g.enemies)do if t.hp>0 then if t.kind=='relay'then relays=relays+1 else alive=alive+1 end end end
 text(self,360,207,g.m.id=='dock'and('RELAIS '..(2-relays)..'/2   |   KANONEN '..alive)or('KANONEN '..alive),'ffd674',.65)
 local n=circle(self,570,108,78,'d63969');text(self,570,108,' FEUER','ffffff',.9);self.buttons[#self.buttons+1]={node=n,action='fire'}
 n=circle(self,145,108,70,'1d5969');text(self,145,108,g.dash_cooldown>0 and string.format('%.1f',g.dash_cooldown)or'» DASH','ffffff',.85);self.buttons[#self.buttons+1]={node=n,action='dash'}
 button(self,355,180,150,46,'? Hinweis','hint','20314b');button(self,355,115,150,46,'Funk','radio','20314b');button(self,355,50,150,46,'Arsenal','gear','20314b')
 -- Small overview of the expanded world; not a shot predictor.
 box(self,360,1173,130,60,'0d1b2e')
 local bounds=g.data.arena
 local function mini(p)return 420-(p[2]-bounds[2])/bounds[4]*120,1148+(1-(p[1]-bounds[1])/bounds[3])*50 end
 for _,t in ipairs(g.enemies)do if t.hp>0 then local x,y=mini(t.p);circle(self,x,y,2.5,t.kind=='relay'and'ffd674'or'ff7394')end end
 local gx,gy=mini(g.m.goal);circle(self,gx,gy,3,'83e9b2')
 local mx,my=mini(g.p);circle(self,mx,my,4,'a1fff0')
 -- Keep all world annotations inside the gameplay viewport, clear of controls.
 local clip=box(self,360,690,720,880,'ffffff');gui.set_clipping_mode(clip,gui.CLIPPING_MODE_STENCIL);gui.set_clipping_visible(clip,false);self.world_parent=clip
 -- Only the current projectile is drawn. Never render shot() / a reflected preview.
 for _,t in ipairs(g.enemies)do if t.hp>0 then
  local x,y=g.project(g,t.p,1.6)
  if t.warning>0 and(x<12 or x>708 or y<265 or y>1115)then
   local ex=math.max(22,math.min(698,x));local ey=math.max(275,math.min(1105,y));circle(self,ex,ey,13,'7b344e');text(self,ex,ey,'!','ffcf8c',.85)
  end
  local max=t.max_hp or 2
  box(self,x,y,48,7,'11223b');box(self,x-(1-t.hp/max)*24,y,48*t.hp/max,7,t.kind=='relay'and'ffd674'or'ff7394')
  local sx,sy=g.project(g,t.p,.1)
  if t.shield or g:locked(t)then circle(self,sx,sy,30,'49346a');circle(self,sx,sy,25,'26374a');text(self,sx,sy,'+','b788ff',.9)end
  if t.warning>0 then
   local mx,my=g.project(g,t.p,.95);local pulse=8+4*math.sin(g.clock*28)^2;circle(self,mx,my,pulse,'ffb47b');text(self,x,y+23,'!','ffd674',1.1)
  end
 end end
 for _,b in ipairs(g.bullets)do local x,y=g.project(g,b.p,.75);circle(self,x,y,9,b.enemy and'783a59'or'23666c');circle(self,x,y,5,b.enemy and'ff6485'or'cafff5')end
 if g.aiming and g.target then local x,y=g.project(g,g.target,0);circle(self,x,y,13,'bcf8e8');circle(self,x,y,10,'173a4a');circle(self,x,y,3,'bcf8e8')end
 if #g.path>0 then local x,y=g.project(g,g.path[#g.path],.1);circle(self,x,y,10,'23666c');circle(self,x,y,4,'a1fff0')end
 for _,f in ipairs(g.fx)do
  local x,y=g.project(g,f.p,.8)
  if f.kind=='explosion'then
   if f.age<.10 then local flash=circle(self,x,y,20*(1-f.age/.1),'fff4b5');gui.set_alpha(flash,.7)end
   local radius=8+f.age*75
   for j=0,15 do local a=j*math.pi/8;local b=(j+1)*math.pi/8
    line(self,x+math.cos(a)*radius,y+math.sin(a)*radius,x+math.cos(b)*radius,y+math.sin(b)*radius,'ffd674',math.max(1,5*f.life/.9))
   end
  else for j=0,5 do local a=j*math.pi/3;circle(self,x+math.cos(a)*f.age*60,y+math.sin(a)*f.age*60,3,'ffd674')end end
 end
 if g.pending_hold and g.touch.pointer then local p=g.touch.pointer
  for j=1,12 do local a=j*math.pi/6;circle(self,p.x+math.cos(a)*22,p.y+math.sin(a)*22,3,j<=g.hold_progress*12 and'ffd674'or'456073')end
 end

 if g.m.heal and not g.heal_used then local x,y=g.project(g,g.m.heal,.4);circle(self,x,y,16,'255a52');text(self,x,y,'+','9affe0',1)end
 if g.m.exit_required then local x,y=g.project(g,g.m.goal,.3);text(self,x,y,alive==0 and'KERN'or'','a1fff0',.65)end

 if g.secret_visible then local x,y=g.project(g,g.m.secret.position,.4);box(self,x,y,25,20,'a066ef');box(self,x,y+8,29,6,'ffd674')end
 if g.clue_time>0 then local p=g:level()>1 and g.m.secret.position or g.m.secret.hint_landmark;local x,y=g.project(g,g.p);local x2,y2=g.project(g,p);line(self,x,y,x2,y2,'ffda7d',3)end
 if g.m.gate_rect then local r=g.m.gate_rect;local x,y=g.project(g,{r[1],r[2]},.6);local x2,y2=g.project(g,{r[1]+r[3],r[2]},.6);line(self,x,y,x2,y2,g:open()and'4edfbd'or'f3a36c',g:open()and 2 or 10);for i=0,2 do local lx,ly=g.project(g,{r[1]+r[3]*(i+1)/4,r[2]+.5},1.5);circle(self,lx,ly,6,g.clock%8>=3+i and'68f6c6'or'43566a')end end
 self.world_parent=nil
 if g.dialog then
  box(self,360,690,680,830,'18253e');self.buttons={};text(self,360,1020,'ENERGYBLAST','ecfff7',1.45)
  if g.dialog=='menu'then text(self,360,965,'AURORA HOP  |  0.4','9db5ce',.8)
   button(self,360,855,570,95,'01  PRISMA-STATION','sector1','255464');text(self,360,793,'ABPRALLER','9db5ce',.55)
   button(self,360,710,570,95,'02  NEON-ZITADELLE','sector2','69395f');text(self,360,648,'DECKUNG & ZEITFENSTER','9db5ce',.55)
   button(self,360,565,570,95,'03  AURORA-DOCK','sector3','725632');text(self,360,503,'RELAIS & BEWEGLICHE GEGNER','ffd674',.55)
   button(self,360,375,570,72,' WEITER','continue')
  elseif g.dialog=='win'then text(self,360,850,'SEKTOR GESICHERT','ffd674',1.05);text(self,360,780,'+ '..g.reward..' *','ffd674',1.2);button(self,360,675,560,85,' BEUTE SUCHEN','loot');button(self,360,560,560,85,' SEKTOREN','menu');button(self,360,450,560,70,' NOCH EINMAL','retry')
  elseif g.dialog=='defeat'then text(self,360,820,'ENERGIE LEER','ff7394',1.3);text(self,360,745,'Sterne bleiben erhalten.','afc8dd',.75);button(self,360,625,560,100,' NEUER ANLAUF','retry','d63969');button(self,360,480,560,80,'||| SEKTOREN','menu')
  else text(self,360,850,'ARSENAL','ffd674',1.2);for i,row in ipairs({'100 * PRISMA: 2 ABPRALLER','160 * RUESTUNG: +1 ENERGIE','230 * STIEFEL: MEHR TEMPO','300 * TARNUNG'})do text(self,360,800-i*65,row,'b8dbe7',.72)end;button(self,360,455,560,75,'WEITER','continue');button(self,360,350,560,65,g.saved.music==false and'MUSIK AUS'or'MUSIK AN','music','315566')end
 end
 if g.ui_test and g.m.id=='dock'and not g.dialog and not self.ui_ready then self.ui_ready=true;local x,y=g.project(g,{g.p[1]+1,g.p[2]-1},0);print('DEFOLD UI READY dock '..math.floor(x)..' '..math.floor(y))end
end
local function handle(self,a)
 local g=_G.energyblast;if not g then return false end
 local key=a.id or 0
 local captured=self.ui_pointers[key]
 if captured then
  if a.released then if captured=='fire'then g.held=false end;self.ui_pointers[key]=nil end
  return true
 end
 if not a.pressed then g.input(a);return true end
 for _,b in ipairs(self.buttons)do if gui.pick_node(b.node,a.x,a.y)then
  if a.pressed then local action=b.action;if g.ui_test then print('DEFOLD UI ACTION '..action..' paused='..tostring(g.paused))end;self.ui_pointers[key]=action;if action~='fire'and action~='dash'and action~='hint'then g.cancel_controls()end
   if action=='fire'then g.held=true;g:fire()elseif action=='dash'then g:dash()elseif action=='hint'then g:hint()elseif action=='sector1'then g.choose(1)elseif action=='sector2'then g.choose(2)elseif action=='sector3'then g.choose(3)elseif action=='menu'then g.paused=true;g.dialog='menu'elseif action=='continue'then g.paused=false;g.dialog=nil elseif action=='retry'then g.choose(g.index)elseif action=='loot'then g.paused=false;g.over=false;g.dialog=nil elseif action=='gear'then g.paused=true;g.dialog='gear'elseif action=='music'then g.toggle_music()elseif action=='sound'then g.toggle_sound()elseif action=='radio'then g.replay()end
  end
  return true
 end end
 if a.y>=250 and a.y<=1130 then g.input(a)end;return true
end
function on_input(self,id,a)
 if id==hash('multitouch')then for _,t in ipairs(a.touch or{})do handle(self,t)end;return true elseif id==hash('touch')then return handle(self,a)elseif id==hash('back')and a.pressed then _G.energyblast.cancel_controls();_G.energyblast.paused=true;_G.energyblast.dialog='menu';return true end
end

function on_message(self,id)if id==hash('cancel_controls')then self.ui_pointers={}end end
