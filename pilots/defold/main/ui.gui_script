function init(self)self.nodes={};self.buttons={};self.ui_pointers={};self.counter=0;self.trap_test=sys.get_config_string('project.trap_test','0')=='1';self.flow_test=sys.get_config_string('project.flow_ui_test','0')=='1';msg.post('.','acquire_input_focus')end
function update(self,dt)
 local g=_G.energyblast;if not g then return end
 self.world_zoom=math.max(1,math.min(1.6,g.zoom or 1))
 if self.trap_test then g.trap_test=true end;if self.flow_test then g.flow_ui_test=true end
 if g.dialog then
  local power=power_state(g)
  local key=table.concat({g.dialog,g:character().id,tostring(g:total()),tostring(g:wallet()),tostring(g.saved.music),g.saved.weapon or'',g.shop_status or'',self.shop_category or 'weapon',tostring(g.hp),tostring(g.max_hp),tostring(g.reward),tostring(g.index),tostring(g.solved),tostring(g.saved.earned['secret:'..g.m.id]),tostring(power.count),tostring(g.shield),tostring(self.menu_page)},'|')
  if key==self.dialog_key then return end;self.dialog_key=key
 else self.dialog_key=nil end
 for _,n in ipairs(self.nodes)do gui.delete_node(n)end;self.nodes={};self.buttons={};self.world_parent=nil
 if g.dialog then self.counter=g:total();dialog(self,g);return end
 panel(self,640,673,1280,96);panel(self,72,360,144,528);panel(self,1208,360,144,528);panel(self,640,48,1280,96)
 self.counter=self.counter+(g:total()-self.counter)*math.min(1,dt*10)
 icon(self,38,678,'star',46);text(self,121,680,tostring(math.floor(self.counter+.5)),'ffe590',1.08,125);text(self,120,649,campaign(g)and'STERNE · ZUM AUSGEBEN TIPPEN'or'GESAMTSTERNE','a6d3e5',campaign(g)and .31 or .42,185)
 if campaign(g)then local n=box(self,124,674,232,92,'ffffff');gui.set_color(n,vmath.vector4(1,1,1,0));self.buttons[#self.buttons+1]={node=n,action='gear',rect={124,674,232,92}}end
 local state=g:mission_state()
 if campaign(g)then
  button(self,634,694,730,39,g.m.title,'mission_menu','blue','menu')
