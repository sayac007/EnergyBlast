local Layout=require 'main.layout'
local Traps=require 'main.trap_controls'
local Objectives=require 'main.objectives'
local SequenceTiming=require 'main.sequence_timing'
local PowerFormat=require 'main.power_format'
local View=require 'main.view'
local Regions=require 'main.hit_regions'
local function campaign(g)return g.data.campaign_enabled==true or g.data.campaign_v14==true end
local function field(g,x,y)return campaign(g)and View.field(g,x,y)or(not campaign(g)and Layout.field(x,y))end
local function picked(g,b,x,y)
 if not campaign(g)then return gui.pick_node(b.node,x,y)end
 local r=b.rect
 return x>=r[1]-r[3]/2 and x<=r[1]+r[3]/2 and y>=r[2]-r[4]/2 and y<=r[2]+r[4]/2
end
local function color(hex)return vmath.vector4(tonumber(hex:sub(1,2),16)/255,tonumber(hex:sub(3,4),16)/255,tonumber(hex:sub(5,6),16)/255,1)end
local function track(self,n)
 gui.set_adjust_mode(n,gui.ADJUST_STRETCH)
 if self.world_parent then gui.set_parent(n,self.world_parent,true)end;self.nodes[#self.nodes+1]=n;return n
end
local function box(self,x,y,w,h,c)
 local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(n,color(c));return track(self,n)
end
local function text(self,x,y,s,c,scale,max_width)
 local n=gui.new_text_node(vmath.vector3(x,y,0),s);gui.set_font(n,'ui');gui.set_color(n,color(c or'ffffff'))
 local scale=(scale or 1)*(self.world_parent and(self.world_zoom or 1)or 1);if max_width and self.world_parent then max_width=max_width*(self.world_zoom or 1)end;local metrics=resource.get_text_metrics(gui.get_font_resource('ui'),s);if max_width and metrics.width*scale>max_width then scale=max_width/metrics.width end
 gui.set_scale(n,vmath.vector3(scale));return track(self,n)
end
local function picture(self,x,y,w,h,name,atlas,sliced)
 local n=box(self,x,y,w,h,'ffffff');gui.set_texture(n,atlas or'interface');gui.play_flipbook(n,name)
 if sliced then gui.set_slice9(n,vmath.vector4(24,24,24,24))end;return n
end
local function panel(self,x,y,w,h)return picture(self,x,y,w,h,'panel',nil,true)end
local function icon(self,x,y,name,size)return picture(self,x,y,size or 46,size or 46,name=='treasure'and'chest-prop'or'ui_'..name)end
local function circle(self,x,y,r,c)
 local n=gui.new_pie_node(vmath.vector3(x,y,0),vmath.vector3(r*2,r*2,0));gui.set_color(n,color(c));gui.set_perimeter_vertices(n,32);return track(self,n)
end
local function button(self,x,y,w,h,title,action,c,ico)
 local palette={['3b5391']='blue',['268974']='green',['b67422']='gold',['804bd1']='violet'}
 local style=palette[c]or c or'blue';local n=picture(self,x,y,w,h,'button_'..style,nil,true)
 if ico then icon(self,x-w/2+35,y+3,ico,36)end
 text(self,x+(ico and 15 or 0),y+3,title,'ffffff',.85,w-(ico and 75 or 22))
 self.buttons[#self.buttons+1]={node=n,action=action,rect={x,y,w,h},world=self.world_parent~=nil};return n
end
local function line(self,x1,y1,x2,y2,c,width)
 local dx,dy=x2-x1,y2-y1;local n=box(self,(x1+x2)/2,(y1+y2)/2,math.sqrt(dx*dx+dy*dy),width or 3,c);gui.set_rotation(n,vmath.vector3(0,0,math.atan2(dy,dx)*180/math.pi))
end
local function ring(self,x,y,r,c,width)
 for j=0,23 do local a=j*math.pi/12;local b=(j+1)*math.pi/12;line(self,x+math.cos(a)*r,y+math.sin(a)*r,x+math.cos(b)*r,y+math.sin(b)*r,c,width or 3)end
end
local function portrait(self,x,y,id,size)return picture(self,x,y,size,size,id,'portraits')end
local function star(self,x,y,r)icon(self,x,y,'star',r*2)end
local function glass(self,x,y,w,h,alpha)
 local n=panel(self,x,y,w,h);gui.set_color(n,vmath.vector4(1,1,1,alpha or .86));return n
end
local function power_state(g)
 return g.power_state and g:power_state()or{count=0,total=12,tier=0,title='DEIN ANFANG',min_health=g.max_hp or 15,visual_scale=1,damage_multiplier=1,shield_max=0,detection_multiplier=1}
end
local function power_button(self,g,x,y,w,h)
 local state=power_state(g)
 if not state.enabled then return end
 local n=picture(self,x,y,w,h,state.count>0 and'button_violet'or'button_blue',nil,true)
 icon(self,x-w/2+26,y+6,'armor',32)
 text(self,x+17,y+7,tostring(state.count)..'/'..tostring(state.total),'fff0a3',.61,w-53)
 text(self,x,y-h/2+12,campaign(g)and'AUSRUESTUNG'or'BONUS-MACHT','d4eaff',.31,w-10)
 self.buttons[#self.buttons+1]={node=n,action='power',rect={x,y,w,h}}
end
local function power_page(self,g)
 local state=power_state(g)
 panel(self,930,376,630,477)
 text(self,930,587,state.title or(campaign(g)and'DEINE AUSRUESTUNG'or'DEINE BONUS-MACHT'),'fff0a6',1.02,578)
 text(self,930,551,tostring(state.count)..' VON '..tostring(state.total)..(campaign(g)and' MISSIONEN · GESUNDHEIT MAXIMAL 100'or' BONI · GROESSE '..math.floor((state.visual_scale or 1)*100+.5)..'%'),'a8ebed',.52,578)
 local cards={
  {x=778,y=476,icon='heart',title='GESUNDHEIT',value=PowerFormat.number(g.max_hp)},
  {x=1082,y=476,icon='armor',title='SCHILD',value=PowerFormat.number(g.max_shield or state.shield_max)},
  {x=778,y=378,icon='cannon',title='FEUERKRAFT',value=campaign(g)and(PowerFormat.decimal(g:weapon_stats().damage)..' SCHADEN')or'x'..PowerFormat.number(state.damage_multiplier)},
  {x=1082,y=378,icon='cloak',title='TARNUNG',value=PowerFormat.percent(1-(g.detection_multiplier and g:detection_multiplier()or state.detection_multiplier or state.cloak_multiplier or 1))}
 }
 for _,card in ipairs(cards)do
  glass(self,card.x,card.y,282,86,.92);icon(self,card.x-104,card.y+1,card.icon,52)
  text(self,card.x+22,card.y+19,card.title,'b3dce9',.43,198)
  text(self,card.x+22,card.y-11,card.value,'ffffff',.84,198)
 end
 local next=state.next
 local target=next and('NOCH '..math.max(0,next.count-state.count)..(campaign(g)and' MISSIONEN: '..PowerFormat.number(math.min(100,next.min_health))..' ENERGIE'or' BONI: '..PowerFormat.number(next.min_health)..' BONUS-ENERGIE'))or(campaign(g)and'ALLE MISSIONEN GESCHAFFT · AUSRUESTUNG BLEIBT'or'ALLE BONI GESCHAFFT · DEINE MACHT BLEIBT')
 text(self,930,305,target,'ffe590',.57,580)
 local milestones=state.milestones or{}
 for i,m in ipairs(milestones)do
  local x=682+(i-1)*124;local earned=state.count>=m.count
  picture(self,x,238,113,89,earned and'button_green'or'panel',nil,true)
  icon(self,x-29,255,earned and'star'or'heart',25)
  text(self,x+15,255,tostring(m.count)..(campaign(g)and' MISSIONEN'or' BONI'),earned and'ffffff'or'aac5d7',.39,77)
  text(self,x,220,PowerFormat.number(m.min_health),earned and'fff0a3'or'b1cbdf',.55,103)
 end
 text(self,930,164,campaign(g)and'TARNUNG HILFT · GEGNER KOENNEN DICH WEITERHIN ORTEN'or'BONI LOESEN · DAUERHAFT STAERKER WERDEN · KEINE STERNKOSTEN','a3d5e2',.42,595)
 button(self,930,78,615,78,'ZURUECK','power_close','green','dash')
 if g.power_ui_test then print('DEFOLD POWER PAGE READY count='..state.count..' hp='..g.max_hp..' shield='..(g.max_shield or 0))end
end
local function mission_card(self,g,m,i,x,y,subtitle)
 -- Real illustrations, cropped at their original aspect ratio. Text has its own
 -- dark contrast strip; the entire image card is one generous touch target.
 glass(self,x,y-4,306,144,.96)
 local clip=box(self,x,y,298,136,'ffffff');gui.set_clipping_mode(clip,gui.CLIPPING_MODE_STENCIL);gui.set_clipping_visible(clip,false)
 local first=#self.nodes+1
 picture(self,x,y+8,300,169,'mission_'..(campaign(g)and(m.theme or m.id)or m.id))
 local shade=box(self,x,y-38,300,62,'07152c');gui.set_color(shade,vmath.vector4(.025,.06,.13,.90))
 local done=(g.saved.earned['bonus:prism:'..m.id]and 1 or 0)+(g.saved.earned['bonus:pattern:'..m.id]and 1 or 0)
 local detail=campaign(g)and(subtitle..' · STUFE '..tostring(m.complexity or m.difficulty or i))or(subtitle..' · BONI '..done..'/2 GEHOLT')
 text(self,x,y-26,m.title,'ffffff',.77,278);text(self,x,y-51,detail,'bdebf1',.41,280)
 if i>=4 and not g.saved.earned['mission:'..m.id]then local tag=box(self,x,y+53,88,24,'d79125');text(self,x,y+53,'NEU','ffffff',.55,80)end
 circle(self,x-123,y+45,19,'142b47')
 if g.saved.earned['mission:'..m.id]then icon(self,x-123,y+46,'star',32)else text(self,x-123,y+45,tostring(i),'ffffff',.70)end
 local symbols={'aim','armor','cannon','trap_magnet','radio','heart'}
 local symbol=campaign(g)and(m.icon or(m.kind=='sequence'and'radio'or m.kind=='trap'and'trap_magnet'or'aim'))or symbols[i]
 circle(self,x+122,y+44,23,'10243c');icon(self,x+122,y+44,symbol,41)
 for j=first,#self.nodes do gui.set_parent(self.nodes[j],clip,true)end
 self.buttons[#self.buttons+1]={node=clip,action='sector'..i,rect={x,y,298,136}}
 gui.set_position(clip,vmath.vector3(x,y-10,0));gui.animate(clip,gui.PROP_POSITION,vmath.vector3(x,y,0),gui.EASING_OUTCUBIC,.24,(i-1)*.025)
end
local function clamp(v,a,b)return math.max(a,math.min(b,v))end
local function viewport(g)
 if not campaign(g)then return Layout end
 local w,h=window.get_size();return View.viewport(g,w,h)
end
local function ground_ring(self,g,p,r,c,width)
 for j=0,47 do
  local a=j*math.pi/24;local b=(j+1)*math.pi/24
  local x1,y1=g.project(g,{p[1]+r*math.cos(a),p[2]+r*math.sin(a)},.08)
  local x2,y2=g.project(g,{p[1]+r*math.cos(b),p[2]+r*math.sin(b)},.08)
  line(self,x1,y1,x2,y2,c,width or 3)
 end
end
local function field_guide(self,g,state)
 local bounds=viewport(g)
 if state.goal and not g.trap_ui and not g.drone_ui then
  if state.goal_kind=='treasure'and g.treasure_state then
   local t=g:treasure_state();local target=state.goal
   local tx,ty=g.project(g,target,.35);local x=clamp(tx,bounds.left+65,bounds.right-65);local y=clamp(ty,bounds.bottom+65,bounds.top-65)
   local off=math.abs(x-tx)>1 or math.abs(y-ty)>1;local size=38+t.proximity*18;local pulse=1+math.sin(g.clock*4)*.06
   circle(self,x,y,size*pulse,'443414');ring(self,x,y,size*pulse,'ffda64',4);icon(self,x,y,'treasure',size*1.4)
   if off then local dx,dy=tx-x,ty-y;local d=math.sqrt(dx*dx+dy*dy);if d>0 then line(self,x+dx/d*size,y+dy/d*size,x+dx/d*(size+15),y+dy/d*(size+15),'ffe394',5)end end
   text(self,clamp(x,bounds.left+176,bounds.right-176),clamp(y-size-15,bounds.bottom+23,bounds.top-23),t.discovered and(t.occluded and'HINTER DER DECKUNG'or t.replay and'NOCH EINMAL FINDEN'or'ZUR TRUHE')or'SUCHGEBIET','ffe99a',.62,205)
   local n=box(self,x,y,size*2,size*2,'ffffff');gui.set_color(n,vmath.vector4(1,1,1,0))
   self.buttons[#self.buttons+1]={node=n,action='treasure_walk',world=true,rect={x,y,size*2,size*2}}
   return
  end
  local tx,ty=g.project(g,state.goal,.15);local x=clamp(tx,bounds.left+48,bounds.right-48);local y=clamp(ty,bounds.bottom+44,bounds.top-44)
  local off=math.abs(x-tx)>1 or math.abs(y-ty)>1;local guide_color=state.goal_kind=='exit'and'78ffb7'or state.goal_kind=='bonus'and'c5a0ff'or'ffe5a0'
  local symbol=state.goal_kind=='treasure'and'treasure'or state.goal_kind=='exit'and'dash'or state.goal_kind=='drone'and'heart'or state.goal_kind=='sequence'and'radio'or state.goal_kind=='bonus'and'star'or'aim'
  if off then
   circle(self,x,y,23,'112a42');icon(self,x,y,symbol,30)
   local dx,dy=tx-x,ty-y;local d=math.sqrt(dx*dx+dy*dy);if d>0 then
    local ux,uy=dx/d,dy/d;local ax,ay=x+ux*28,y+uy*28
    line(self,x+ux*19,y+uy*19,ax,ay,guide_color,4);line(self,ax,ay,ax-ux*8-uy*5,ay-uy*8+ux*5,guide_color,3);line(self,ax,ay,ax-ux*8+uy*5,ay-uy*8-ux*5,guide_color,3)
   end
  else ground_ring(self,g,state.goal,.65,state.goal_kind=='treasure'and'ffda79'or state.goal_kind=='exit'and'78ffb7'or'8cebe7',2)end
  local title=state.goal_kind=='treasure'and'SCHATZSPUR'or state.goal_kind=='exit'and'AUSGANG'or state.goal_kind=='drone'and'DROHNE'or state.goal_kind=='sequence'and'LICHTER'or state.goal_kind=='bonus'and'BONUS'or'ZIEL'
  text(self,clamp(x,bounds.left+85,bounds.right-85),clamp(y-34,bounds.bottom+16,bounds.top-16),title,guide_color,.43,160)
 end
end
local function field_traps(self,g)
 if not Objectives.can_trap(g)or g.over then return end
 if campaign(g)and g.drone_ui then return end
 local bounds=viewport(g)
 local px,py=g.project(g,g.p,.4)
 local bx=clamp(px+87,bounds.left+54,bounds.right-54);local by=clamp(py+20,bounds.bottom+58,bounds.top-58)
 if not g.trap_ui then
  local n=picture(self,bx,by,92,92,'button_violet',nil,true);icon(self,bx,by+9,'trap_magnet',61)
  text(self,bx,by-29,g.trap_cooldown>0 and tostring(math.ceil(g.trap_cooldown))..' s'or'FALLEN','ffffff',.48,83)
  self.buttons[#self.buttons+1]={node=n,action='trap_open',world=true,rect={bx,by,92,92}}
  if g.trap_test and not self.trap_ready then self.trap_ready=true;print('DEFOLD FIELD TRAP READY '..math.floor(bx)..' '..math.floor(by))end
  return
 end
 local ui=g.trap_ui
 local x=clamp(px,bounds.left+240,bounds.right-240);local y=clamp(py,bounds.bottom+190,bounds.top-175)
 if ui.mode=='catalogue'then
  local dim=box(self,640,360,bounds.right-bounds.left,bounds.top-bounds.bottom,'111e41');gui.set_color(dim,vmath.vector4(.04,.08,.2,.82))
  panel(self,x,y,470,329);text(self,x,y+138,'WAEHLE DEINE FALLE','ffffff',.93,430)
  local offsets={-145,0,145}
  for i,base in ipairs(Objectives.catalogue)do
   local spec=Objectives.trap_spec(base.id,g)
   local cx=x+offsets[i];local cy=y+31+(i==2 and 16 or 0)
   local n=picture(self,cx,cy,130,132,'button_'..(i==1 and'violet'or i==2 and'blue'or'gold'),nil,true)
   icon(self,cx,cy+17,spec.icon,83);text(self,cx,cy-39,spec.name,'ffffff',.65,120)
   text(self,cx,cy-85,string.format('%g s FEST',spec.duration):gsub('%.',','),'c9eaff',.48,135)
   if spec.damage then text(self,cx,cy-105,tostring(spec.damage)..' SCHADEN','ffe19b',.37,135)end
   self.buttons[#self.buttons+1]={node=n,action='trap_select:'..spec.id,world=true,rect={cx,cy,130,132}}
   if g.trap_test and self.trap_logged_mode~=ui.mode then print('DEFOLD FIELD TRAP OPTION '..spec.id..' '..math.floor(cx)..' '..math.floor(cy))end
  end
  button(self,x,y-123,210,58,'ABBRECHEN','trap_cancel','blue','trap_cancel')
  if g.trap_test and self.trap_logged_mode~=ui.mode then print('DEFOLD FIELD TRAP CANCEL '..math.floor(x)..' '..math.floor(y-123))end
 else
  ground_ring(self,g,g.p,Traps.range_for(g),'befff2',5)
  -- Light only valid floor inside the same world-space range the controller uses.
  -- Dots make the larger reachable area legible without painting over the scene.
  local r=Traps.range_for(g)
  for row=-3,3 do for column=-3,3 do
   local p={g.p[1]+column*r/3.5,g.p[2]+row*r/3.5}
   if (column~=0 or row~=0)and g.trap_control:valid(p)then
    local x,y=g.project(g,p,.08);circle(self,x,y,2,'a9f9dc')
   end
  end end
  local preview=ui.preview or g.p;local spec=Objectives.trap_spec(ui.selected,g)
  ground_ring(self,g,preview,spec.radius,ui.valid and'9cffce'or'ff718e',4)
  local tx,ty=g.project(g,preview,.12)
  local n=icon(self,tx,ty+21,spec.icon,64);gui.set_color(n,vmath.vector4(1,1,1,.70))
  text(self,clamp(tx,bounds.left+160,bounds.right-160),clamp(ty-45,bounds.bottom+24,bounds.top-24),ui.reason,ui.valid and'a7ffd9'or'ff90a8',.57,310)
  -- Only this cancel control is overlaid; the rest of the floor remains a target.
  local cy=bounds.top-42
  button(self,bounds.right-114,cy,214,64,'ABBRECHEN','trap_cancel','blue','trap_cancel')
  text(self,bounds.left+290,cy,'TIPPE AUF FREIEN BODEN','d6fff0',.75,500)
  if g.trap_test and self.trap_logged_mode~=ui.mode then
   -- Exercise a real floor point beyond the former 3.5-unit placement circle.
   local tx,ty=g.project(g,{g.p[1]+4.4,g.p[2]},0)
   print('DEFOLD FIELD TRAP FLOOR '..math.floor(tx)..' '..math.floor(ty))
   print('DEFOLD FIELD TRAP CIRCLE radius='..Traps.range_for(g)..' duration='..spec.duration..' lifetime='..Objectives.trap_timing(g).armed_lifetime)
  end
 end
 self.trap_logged_mode=ui.mode
end
local function field_drone(self,g)
 if not campaign(g)or not g.attack_drone or not g.attack_drone.enabled or g.over then return end
 if g.trap_ui then return end
 local d=g.attack_drone;local ui=g.drone_ui;local bounds=viewport(g)
 local px,py=g.project(g,g.p,.4)
 local bx=clamp(px-100,bounds.left+51,bounds.right-51);local by=clamp(py+20,bounds.bottom+55,bounds.top-55)
 if not ui then
  -- Keep the two tactical controls separate even beside a viewport edge.
  for _,b in ipairs(self.buttons)do if b.action=='trap_open'then
   local r=b.rect
   if math.abs(bx-r[1])<97 and math.abs(by-r[2])<97 then
    local choices={{r[1]-104,r[2]},{r[1],r[2]+106},{r[1],r[2]-106},{r[1]+104,r[2]}}
    for _,p in ipairs(choices)do
     local x=clamp(p[1],bounds.left+51,bounds.right-51);local y=clamp(p[2],bounds.bottom+55,bounds.top-55)
     if math.abs(x-r[1])>=97 or math.abs(y-r[2])>=97 then bx,by=x,y;break end
    end
   end
  end end
  local busy=d.phase=='flying'or d.phase=='cooldown'
  local n=picture(self,bx,by,90,90,busy and'button_blue'or d.stock>0 and'button_gold'or'panel',nil,true)
  icon(self,bx,by+12,'attack_drone',58)
  text(self,bx,by-27,busy and'UNTERWEGS'or'DROHNEN '..d.stock,'ffffff',.43,84)
  self.buttons[#self.buttons+1]={node=n,action='drone_open',world=true,rect={bx,by,90,90}}
  if g.campaign_ui_test and self.drone_ready~=g.index then self.drone_ready=g.index;print('DEFOLD CAMPAIGN DRONE BADGE '..math.floor(bx)..' '..math.floor(by)..' stock='..d.stock)end
  return
 end
 local x=clamp(px,bounds.left+245,bounds.right-245);local y=clamp(py,bounds.bottom+164,bounds.top-164)
 if ui.mode=='catalogue'then
  local dim=box(self,(bounds.left+bounds.right)/2,(bounds.bottom+bounds.top)/2,bounds.right-bounds.left,bounds.top-bounds.bottom,'111e41');gui.set_color(dim,vmath.vector4(.04,.08,.2,.82))
  panel(self,x,y,460,312)
  text(self,x,y+124,'DEIN DROHNENVORRAT','ffffff',.87,420)
  local n=picture(self,x,y+15,250,153,d.stock>0 and'button_gold'or'panel',nil,true)
  icon(self,x,y+40,'attack_drone',87)
  text(self,x,y-29,'ANGRIFFSDROHNE','ffffff',.61,233)
  text(self,x,y-64,tostring(d.stock)..' VON '..tostring(d.max_stock)..' BEREIT','c9eaff',.49,300)
  self.buttons[#self.buttons+1]={node=n,action='drone_select',world=true,rect={x,y+15,250,153}}
  button(self,x,y-112,250,58,'ABBRECHEN','drone_cancel','blue','trap_cancel')
  if g.campaign_ui_test and self.logged_drone_mode~='catalogue'then
   print('DEFOLD CAMPAIGN DRONE OPTION '..math.floor(x)..' '..math.floor(y+15)..' stock='..d.stock)
   print('DEFOLD CAMPAIGN DRONE CANCEL '..math.floor(x)..' '..math.floor(y-112)..' mode=catalogue')
  end
 else
  local tx=clamp(ui.dragging and(ui.x or bx)or bx,bounds.left+48,bounds.right-48)
  local ty=clamp(ui.dragging and(ui.y or by)or by,bounds.bottom+52,bounds.top-52)
  ui.rect={tx,ty,94,94}
  ring(self,tx,ty,46,'ffe38b',4);icon(self,tx,ty+3,'attack_drone',73)
  if ui.dragging then
   local enemy=Regions.enemy(g,ui.x or tx,ui.y or ty)
   if enemy then local r=Regions.bounds(g,enemy);ring(self,r.x,r.y,math.max(24,math.min(46,r.w/2)),'ffd375',3)end
  end
  text(self,tx,clamp(ty-64,bounds.bottom+22,bounds.top-22),'ZUM GEGNER ZIEHEN','fff0a3',.43,190)
  local cy=bounds.top-35
  button(self,bounds.right-112,cy,210,58,'ABBRECHEN','drone_cancel','blue','trap_cancel')
  text(self,bounds.left+250,cy,'TIPPE AUF EINEN GEGNER','fff0ac',.66,450)
  if g.campaign_ui_test and self.logged_drone_mode~='target'then
   print('DEFOLD CAMPAIGN DRONE PREVIEW '..math.floor(tx)..' '..math.floor(ty)..' stock='..d.stock)
   print('DEFOLD CAMPAIGN DRONE CANCEL '..math.floor(bounds.right-112)..' '..math.floor(cy)..' mode=target')
  end
 end
 self.logged_drone_mode=ui.mode
end
local function page(self,g,title)
 -- The background is a separate earlier render pass; the animated 3D hero stays visible.
 text(self,284,673,'ENERGYBLAST','ffffff',1.30,515);text(self,284,633,campaign(g)and'ANGRIFFSDROHNEN  ·  0.14'or'BONUS-MACHT  ·  0.13','a3e7df',.61)
 glass(self,930,670,640,82,.86);text(self,930,682,title,'ffffff',.96,590)
 icon(self,665,652,'star',29);text(self,744,652,tostring(g:total())..' GESAMT','ffe58b',.56,180)
 text(self,1080,652,g:wallet()..' ZUM AUSGEBEN','a4f3d5',.56,220)
 text(self,284,316,g:character().shot=='fireball'and'DRACHE FLAMMI'or g:character().name,'fff0a6',1.02,500)
 text(self,284,285,g:character().shot=='fireball'and'FEUERBAELLE' or'DEIN HELD','a3e7df',.55,480)
end
local function hero_choices(self,g)
 for i,c in ipairs(g.data.characters)do
  local x=110+(i-1)*174;local y=193;local chosen=g:character().id==c.id
  local n=picture(self,x,y,156,176,chosen and'button_green'or'panel',nil,true)
  portrait(self,x,y+17,c.id,134)
  text(self,x,y-57,c.id=='dragon'and'DRACHE'or c.name,'ffffff',.61,144)
  text(self,x,y-77,chosen and'GEWAEHLT'or'ANTIPPEN',chosen and'b7ffdf'or'b9dce6',.38,140)
  self.buttons[#self.buttons+1]={node=n,action='character:'..c.id,rect={x,y,156,176}}
 end
end

local function shop_row(self,g,u,y)
 local tint=u.locked and '7790ad'or 'ffffff'
 local n=glass(self,930,y,625,92,u.locked and .68 or .94)
 circle(self,668,y,35,u.locked and '15263a'or '0c203c')
 local ico=u.category=='armor'and 'armor'or u.category=='weapon'and 'cannon'or u.id=='regen_core'and 'heart'or 'cloak'
 local image=icon(self,668,y+2,ico,74)
 if u.locked then gui.set_color(image,vmath.vector4(.55,.62,.72,.7))end
 text(self,850,y+20,u.title or u.id,tint,.65,265)
 text(self,850,y-8,u.description or '',u.locked and '7991a7'or 'afd9e0',.42,265)
 local label,style
 if u.owned then
  label=u.category=='weapon'and(u.equipped and 'AUSGERUESTET'or 'AUSWAEHLEN')or 'GEKAUFT'
  style=u.equipped and 'green'or u.category=='weapon'and 'violet'or 'green'
 elseif u.locked then label='DANACH '..u.price;style='blue'
 elseif campaign(g)and u.unavailable_reason then label='MAXIMAL 100';style='blue'
 else label='KAUFEN '..u.price;style=u.available and 'gold'or 'blue'end
 local b=button(self,1130,y,183,75,label,'buy:'..u.id,style,u.owned and 'gear'or 'star')
 if u.locked then
  gui.set_color(b,vmath.vector4(.48,.57,.70,.74))
  text(self,850,y-31,'NAECHSTE STUFE · '..u.price..' STERNE','9aafc6',.34,265)
 elseif campaign(g)and u.unavailable_reason then
  text(self,850,y-31,u.unavailable_reason,'a9d2df',.34,265)
 elseif not u.owned and(u.missing or 0)>0 then
  text(self,1130,y-31,'NOCH '..u.missing..' STERNE','c9d5eb',.31,170)
 end
 if g.ui_test or g.flow_ui_test then print('DEFOLD SHOP ITEM '..u.id..' 1130 '..y..' can='..tostring(u.available)..' owned='..tostring(u.owned)..' locked='..tostring(u.locked))end
end
local function shop(self,g)
 local category=self.shop_category or 'weapon'
 text(self,930,612,g.shop_status or 'WAFFEN UND RUESTUNG STUFENWEISE VERBESSERN','ffe38b',.45,605)
 for i,t in ipairs({{'weapon','WAFFEN','cannon'},{'armor','RUESTUNG','armor'},{'extra','EXTRAS','cloak'}})do
  button(self,720+(i-1)*210,578,198,49,t[2],'shop_tab:'..t[1],category==t[1]and 'violet'or 'blue',t[3])
 end
 local items=g:shop_items(category)
 for i,u in ipairs(items)do if i<=4 then shop_row(self,g,u,510-(i-1)*101)end end
 -- This permanent refill stays visible in every category; no permanent purchase
 -- flag is used, so damage can always be healed again for the advertised price.
 local health=g:shop_item('health')
 glass(self,284,199,490,168,.94);icon(self,77,235,'heart',54)
 text(self,295,252,'GESUNDHEIT AUFFUELLEN','ffffff',.72,365)
 text(self,284,216,PowerFormat.number(g.hp)..' / '..PowerFormat.number(g.max_hp)..' ENERGIE','b9e9df',.64,390)
 local full=g.hp>=g.max_hp
 button(self,284,166,430,63,full and 'VOLL · '..health.price..' STERNE BEI BEDARF'or 'HEILEN · '..health.price..' STERNE','buy:health',full and 'blue'or health.available and 'green'or 'blue','heart')
 if not full and(health.missing or 0)>0 then text(self,284,123,'NOCH '..health.missing..' STERNE','c9d5eb',.40,435)else text(self,284,123,'BEI SCHADEN IMMER WIEDER KAUFBAR','a4dacd',.37,435)end
 if g.ui_test or g.flow_ui_test then print('DEFOLD SHOP ITEM health 284 166 can='..tostring(health.available)..' full='..tostring(full)..' hp='..g.hp..' max='..g.max_hp)end
 text(self,930,119,'VERFUEGBAR '..g:wallet()..'  ·  GESAMT '..g:total(),'b8dce4',.49,610)
 button(self,770,63,295,75,'ZUM SPIEL','continue','green','dash');button(self,1090,63,295,75,'MISSIONEN','menu','blue','menu')
 button(self,284,63,490,78,g.saved.music==false and 'MUSIK AUS'or 'MUSIK AN','music','violet','sound')
 if g.flow_ui_test then print('DEFOLD FLOW SHOP READY wallet='..g:wallet())end
 if g.ui_test or g.flow_ui_test then print('DEFOLD SHOP TAB '..category)end
end

local function dialog(self,g)
 self.buttons={};local state=g:mission_state()
 page(self,g,g.dialog=='menu'and'DEINE MISSIONEN'or g.dialog=='gear'and'STERNE AUSGEBEN'or g.dialog=='characters'and'DEIN HELD'or g.dialog=='power'and(campaign(g)and'DEINE AUSRUESTUNG'or'DEINE BONUS-MACHT')or g.dialog=='objective'and'DEIN AUFTRAG'or'GESCHAFFT!')
 if g.dialog~='power'then power_button(self,g,493,354,140,68)end
 if g.dialog=='menu'then
  local names={'ABPRALLER','DECKUNG & TIMING','RELAIS & BOSS','MAGNETFALLEN','LICHTERFOLGE','DROHNE RETTEN'}
  local pages=math.ceil(#g.data.missions/6)
  if campaign(g)then self.menu_page=clamp(self.menu_page or math.floor((g.index-1)/6)+1,1,pages)end
  local first=campaign(g)and((self.menu_page-1)*6+1)or 1
  local last=campaign(g)and math.min(#g.data.missions,first+5)or#g.data.missions
  for i=first,last do
   local m=g.data.missions[i];local slot=campaign(g)and(i-first)or(i-1)
   local x=slot%2==0 and 772 or 1090;local y=534-math.floor(slot/2)*153
   mission_card(self,g,m,i,x,y,campaign(g)and(m.subtitle or m.description or'MISSION '..i)or names[i])
  end
  hero_choices(self,g)
  local next=g.solved and g:next_index()
  local by=campaign(g)and 67 or 83;local bh=campaign(g)and 70 or 78
  button(self,807,by,366,bh,next and'NAECHSTE MISSION'or'MISSION '..g.index..(campaign(g)and' FORTSETZEN'or' STARTEN'),next and'next'or'continue','green','dash')
  button(self,1130,by,250,bh,'ALLE HELDEN','characters','blue','heart')
  if campaign(g)then
   if self.menu_page>1 then button(self,657,134,70,48,'<','missions_prev','blue')end
   text(self,930,134,'SEITE '..self.menu_page..' / '..pages..'  ·  '..#g.data.missions..' MISSIONEN','cae8ee',.52,440)
   if self.menu_page<pages then button(self,1207,134,70,48,'>','missions_next','blue')end
   if g.campaign_ui_test then print('DEFOLD CAMPAIGN MENU PAGE '..self.menu_page..' first='..first..' last='..last..' current='..g.index)end
  end
  button(self,284,63,490,78,'STERNE AUSGEBEN · '..g:wallet(),'gear','gold','star')
  if g.ui_test and not self.menu_ready then self.menu_ready=true;print('DEFOLD MENU READY')end
  if g.flow_ui_test then print('DEFOLD FLOW MENU READY mission='..g.index..' wallet='..g:wallet()..' hero='..g:character().id)end
 elseif g.dialog=='characters'then
  for i,c in ipairs(g.data.characters)do local x=725+(i-1)*205;local chosen=g:character().id==c.id
   glass(self,x,389,195,380,.82);local n=portrait(self,x,448,c.id,203)
   self.buttons[#self.buttons+1]={node=n,action='character:'..c.id,rect={x,448,195,240}}
   text(self,x,325,c.id=='dragon'and'DRACHE FLAMMI'or c.name,chosen and'ffe493'or'ffffff',.70,180)
   text(self,x,291,c.shot=='fireball'and'FEUERBALL'or'ENERGIE','b8dce4',.50,170)
   button(self,x,237,190,77,chosen and'GEWAEHLT'or'WAEHLEN','character:'..c.id,chosen and'green'or'violet','heart')
  end
  button(self,930,83,615,78,'ZURUECK ZU DEN MISSIONEN','menu','blue','menu')
 elseif g.dialog=='power'then
  power_page(self,g)
 elseif g.dialog=='objective'and campaign(g)then
  panel(self,930,375,630,478)
