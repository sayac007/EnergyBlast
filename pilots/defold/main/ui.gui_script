 end
 for _,name in ipairs({'menu','sound','hint','radio','gear'})do local r=Layout.controls[name];local title=({menu='',sound='',hint='HINWEIS',radio='FUNK',gear='STERNE'})[name]
  if name=='menu'or name=='sound'then button(self,r[1],r[2],r[3],r[4],'',name,'blue');icon(self,r[1],r[2]+2,name,37)
  else
