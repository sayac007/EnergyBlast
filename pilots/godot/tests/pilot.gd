extends SceneTree
var checks=0
var failures=[]
const G=preload("res://core/geometry.gd")
const P=preload("res://core/progress.gd")
func check(value: bool, message: String):
	checks+=1
	if not value: failures.append(message);push_error(message)
func _initialize():call_deferred("run")
func run():
	var data=JSON.parse_string(FileAccess.get_file_as_string("res://assets/pilot.json"))
	var path="user://test-progress-"+str(OS.get_process_id())+".json"
	var save=P.new(data,path)
	check(save.total()==0 and save.hint_count()==0,"Fresh stars and clues")
	check(not save.buy_clue("bank"),"No unearned clue purchase")
	check(save.award("mission:bank")==75,"First mission award")
	check(save.hint_count()==2,"Two clues earned by unique mission")
	check(save.award("mission:bank")==0 and save.hint_count()==2,"No replay farming")
	check(save.award("secret:bank")==50 and save.hint_count()==2,"Secret does not mint mission clues")
	check(save.buy_clue("bank") and save.hint_count()==1,"One clue consumed")
	var restored=P.new(data,path)
	check(restored.total()==125 and restored.clue_level("bank")==1 and restored.hint_count()==1,"Persist scores and consumed clue")
	check(restored.stats().bounces==2,"Prism unlock actually changes bounce budget")
	check(restored.buy_clue("bank") and not restored.buy_clue("bank"),"Cannot buy the same clue repeatedly")
	for id in data.rewards:restored.award(id)
	check(restored.total()==325,"All current rewards bounded at 325")
	check(restored.stats().speed>3 and restored.stats().grace>1 and restored.stats().cloak>0,"Actual speed, armor and partial cloak effects")
	check(restored.stats().cloak<.5,"Base perception/cover challenge retained")
	var mirror=[{"rect":Rect2(-10,-4.6,20,.25),"kind":"reflector"}]
	var result=G.trace(Vector2(-4,3.2),Vector2(8.5,-11.9),mirror)
	check(result.bounces==1,"One reflection recorded")
	check(G.segment_distance(Vector2(4.5,0),result.points[1],result.points[2])<.01,"Mirror-target analytic solution")
	check(G.trace(Vector2.ZERO,Vector2.RIGHT,[{"rect":Rect2(1,-1,.3,2),"kind":"cover"}]).bounces==0,"Cover absorbs; not all walls reflect")
	var walls=[{"rect":Rect2(1,-1,.4,2),"kind":"cover"}]
	check(not G.visible(Vector2.ZERO,Vector2.RIGHT,Vector2(3,0),6,70,walls),"Cover blocks detection")
	check(G.visible(Vector2.ZERO,Vector2.RIGHT,Vector2(.8,0),6,70,walls),"Clear cone sees target")
	check(not G.visible(Vector2.ZERO,Vector2.RIGHT,Vector2(0,3),6,70,[]),"Outside cone is safe")
	for t in [0.0,2.0,4.99,8.0]:check(not G.gate_open(t,data.gate),"Closed timing "+str(t))
	for t in [5.0,6.0,7.99,13.0]:check(G.gate_open(t,data.gate),"Open timing "+str(t))
	var scene=load("res://main.tscn").instantiate()
	root.add_child(scene)
	await process_frame
	scene.set_process(false)
	scene.progress=P.new(data,"user://test-game-"+str(OS.get_process_id())+".json")
	scene.voice.enabled=false
	scene.start_mission(0)
	var aim_screen=scene.camera.unproject_position(Vector3(1.392857,0,-4.35))
	scene.select_mode("aim")
	var touch=InputEventScreenTouch.new();touch.pressed=true;touch.position=aim_screen
	scene._unhandled_input(touch)
	check(scene.aim.dot(Vector2(8.5,-11.9).normalized())>.9999,"Touchscreen ray defines intended aim")
	scene.select_mode("predict")
	touch.position=scene.camera.unproject_position(Vector3(4.5,0,0));scene._unhandled_input(touch)
	check(scene.prediction.distance_to(Vector2(4.5,0))<.01,"Touch prediction marker")
	scene.shoot();check(scene.pending_win,"Playable bank shot reaches switch after bounce")
	scene._process(1.0)
	check(scene.complete and scene.progress.total()==100 and scene.progress.hint_count()==2,"Real mission completes and pays once")
	scene.popup.hide();scene.complete=false;scene._process(.1)
	check(not scene.popup.visible,"Exploring after win does not immediately reopen win panel")
	scene.start_mission(1);scene.menu_panel.hide();scene.popup.hide()
	scene.player_pos=Vector2(-3.5,0);scene.select_mode("trap")
	scene.touch_world(scene.camera.unproject_position(Vector3(-.5,0,0)))
	check(scene.trap_pos==null,"Cannot place capture field through cover")
	scene.player_pos=Vector2(-5,-3);scene.select_mode("trap")
	scene.touch_world(scene.camera.unproject_position(Vector3(-4.5,0,-2.6)))
	check(scene.trap_pos!=null and scene.trap_used,"Visible nearby field is placeable")
	scene.tick_guardian(.01)
	check(scene.guard_frozen>3 and scene.trap_pos==null,"Guardian actually triggers capture field")
	scene.tick_guardian(3.6)
	check(scene.guard_frozen<=0,"Field restraint expires rather than permanent immobilization")
	scene.start_mission(1);scene.menu_panel.hide();scene.popup.hide()
	scene.guard_frozen=100
	var before=scene.progress.total()
	for i in range(100):scene._process(.1)
	check(scene.progress.total()==before,"No stars for waiting")
	scene.clock=0;scene.navigate(Vector2(5.2,-3.5))
	check(not scene.route.is_empty(),"Closed gate leads to staging instead of dead-end controls")
	check(scene.route[-1].y> -1.1,"No queued automatic crossing before decision window")
	scene.player_pos=Vector2(5.1,0);scene.clock=5.01;scene.navigate(Vector2(5.2,-3.5))
	check(not scene.route.is_empty() and scene.route[-1].y< -3,"Open window admits tap-to-move path")
	for i in range(20):scene._process(.1)
	check(scene.mission_solved,"Gate window completable with base traversal")
	check(scene.progress.total()>=200,"Both goals paid")
	var slots=scene.definition.rewards.size()
	check(slots==6,"Only specified unique rewards")
	scene.voice.end_all();await create_timer(.15).timeout
	scene.queue_free();await process_frame;await process_frame
	for filename in [path,path+".bak", "user://test-game-"+str(OS.get_process_id())+".json", "user://test-game-"+str(OS.get_process_id())+".json.bak"]:
		if FileAccess.file_exists(filename):DirAccess.remove_absolute(ProjectSettings.globalize_path(filename))
	print("ENERGYBLAST: ",checks," checks; ",failures.size()," failures")
	quit(0 if failures.is_empty() else 1)
